{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cheats-mw4",
  "main": "workers/seo-host.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": true
  }
}
